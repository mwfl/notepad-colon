{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 21, "patch": 0},
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "MWFL_SOURCE_DIR": "${sourceDir}/../mwfl"
      }
    },
    {"name": "vs2026-x64", "inherits": "base", "generator": "Visual Studio 18 2026", "architecture": "x64"}
  ],
  "buildPresets": [
    {"name": "vs2026-x64-debug", "configurePreset": "vs2026-x64", "configuration": "Debug"},
    {"name": "vs2026-x64-release", "configurePreset": "vs2026-x64", "configuration": "Release"}
  ],
  "testPresets": [
    {"name": "vs2026-x64-debug", "configurePreset": "vs2026-x64", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "vs2026-x64-release", "configurePreset": "vs2026-x64", "configuration": "Release", "output": {"outputOnFailure": true}}
  ]
}
